[mysqld]
server-id=7
# read_only y super_read_only NO van aqui: con un volumen vacio impiden que la imagen
# de MySQL fije la contrasena de root (ERROR 1290). Los activa de forma persistente
# mysql/slave-init/01-replication.sh al terminar la inicializacion.
relay-log=relay-bin
gtid_mode=ON
enforce_gtid_consistency=ON
